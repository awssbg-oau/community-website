---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import ShowcaseItem from '../../components/ShowcaseItem.astro';

export async function getStaticPaths() {
  const items = await getCollection('showcase');
  return items.map((item) => ({ params: { id: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const { title, kind, by, date, stack, link, photo, sample } = item.data;
const label = { build: 'Build', win: 'Win', moment: 'Moment' }[kind];
const icon = ({ build: 'build', win: 'win', moment: 'moment' } as const)[kind];
const when = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Africa/Lagos' }).format(date);
const others = (await getCollection('showcase')).filter((o) => o.id !== item.id).slice(0, 3);
---

<Base title={title} description={`${label} by ${by} · AWS Student Builder Group OAU`}>
  <section class="top theme-header sbg-grid">
    <div class="page inner">
      <a class="back" href="/spotlight/"><Icon name="arrowLeft" size={16} /> All Spotlights</a>
      <p class="meta">
        <span class="tag"><Icon name={icon} size={16} />{label}</span>
        {sample && <span class="sample">Sample</span>}
      </p>
      <h1>{title}</h1>
      <p class="by">{by} · {when}</p>
      {stack.length > 0 && <ul class="stack">{stack.map((s) => <li>{s}</li>)}</ul>}
    </div>
  </section>

  <div class="page body">
    {photo && <img class="photo" src={photo} alt={title} />}
    <article class="prose"><Content /></article>
    {
      link && (
        <Button href={link} trailing="external" external>
          See It Live
        </Button>
      )
    }
  </div>

  {
    others.length > 0 && (
      <section class="page more">
        <h2>More Spotlights</h2>
        <ul class="grid">
          {others.map((o, i) => (
            <ShowcaseItem item={o} index={i} />
          ))}
        </ul>
      </section>
    )
  }
</Base>

<style>
  .inner {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-8) var(--space-8);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    width: fit-content;
    min-height: 44px;
    color: var(--ink);
    text-decoration: none;
  }

  .back:hover {
    text-decoration: underline;
  }

  .meta {
    display: flex;
    gap: var(--space-3);
    align-items: center;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    border-radius: 999px;
    background: #ff9900;
    color: #0f141a;
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
  }

  .sample {
    padding: 2px 10px;
    border: 1px dashed currentColor;
    border-radius: 999px;
    font-size: var(--text-caption);
  }

  h1 {
    max-width: 20ch;
    font-size: var(--text-display);
  }

  .by {
    color: var(--muted);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stack li {
    padding: 4px 10px;
    border: 1.5px solid var(--border-strong);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: var(--text-caption);
  }

  .body {
    display: grid;
    gap: var(--space-6);
    justify-items: start;
    max-width: calc(760px + 2 * var(--gutter));
    padding-block: var(--space-8);
  }

  .photo {
    width: 100%;
    border: 2px solid var(--ink);
    border-radius: var(--radius-lg);
  }

  .prose {
    display: grid;
    gap: var(--space-4);
    font-size: 1.125rem;
    line-height: 1.7;
  }

  .more {
    display: grid;
    gap: var(--space-5);
    padding-top: var(--space-6);
  }

  .more h2 {
    font-size: var(--text-title);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
