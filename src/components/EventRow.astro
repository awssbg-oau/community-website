---
import Button from './Button.astro';
import Icon from './Icon.astro';
import Tag from './Tag.astro';
import { dayOfMonth, isUpcoming, monthShort, shortDate, timeRange, type EventEntry } from '../lib/events';

interface Props {
  event: EventEntry;
  now: Date;
  index?: number;
}

const { event, now, index = 0 } = Astro.props;
const { title, start, end, mode, venue, meetup, attended } = event.data;
const upcoming = isUpcoming(event, now);
---

<li class="row" data-reveal style={`--i:${index}`}>
  <div class="date tnum" aria-hidden="true">
    <span class="month">{monthShort(start)}</span>
    <span class="day">{dayOfMonth(start)}</span>
  </div>
  <div class="main">
    <p class="meta tnum">
      {upcoming ? <Tag tone="brand">Upcoming</Tag> : <Tag>Ended</Tag>}
      <span>{shortDate(start)} · {timeRange(start, end)}</span>
    </p>
    <h3 class="title"><a href={`/events/${event.id}/`}>{title}</a></h3>
    <p class="venue">
      <Icon name={mode === 'online' ? 'online' : 'location'} size={16} />
      <span>{venue}</span>
    </p>
  </div>
  <div class="action">
    {
      upcoming ? (
        <Button href={meetup} variant="secondary" size="sm" trailing="external" external>
          RSVP
        </Button>
      ) : (
        attended !== undefined && (
          <p class="attended tnum">
            <Icon name="people" size={16} />
            <span>{attended} attended</span>
          </p>
        )
      )
    }
  </div>
</li>

<style>
  .row {
    display: grid;
    grid-template-columns: 56px 1fr auto;
    gap: var(--space-4) var(--space-5);
    align-items: center;
    padding: var(--space-5) 0;
    border-top: 1px solid var(--border);
  }

  .row:hover .date {
    background: var(--brand-soft);
  }

  .date {
    transition: background-color var(--dur-base) var(--ease-out);
    display: grid;
    justify-items: center;
    gap: 2px;
    padding: var(--space-2) 0;
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .month {
    font-size: var(--text-caption);
    font-weight: var(--weight-medium);
    color: var(--brand);
  }

  .day {
    font-size: 1.5rem;
    line-height: 1;
    font-weight: var(--weight-medium);
  }

  .main {
    display: grid;
    gap: var(--space-2);
    min-width: 0;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    font-size: var(--text-small);
    color: var(--muted);
  }

  .title {
    font-size: var(--text-heading);
    line-height: 1.3;
  }

  .title a {
    color: var(--ink);
    text-decoration: none;
  }

  .title a:hover {
    color: var(--brand);
    text-decoration: underline;
  }

  .venue,
  .attended {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-small);
    color: var(--muted);
  }

  .attended {
    white-space: nowrap;
  }

  @media (max-width: 560px) {
    .row {
      grid-template-columns: 48px 1fr;
      align-items: start;
    }

    .action {
      grid-column: 2;
    }

    .action:empty {
      display: none;
    }
  }
</style>
