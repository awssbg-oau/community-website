---
interface Tab {
  label: string;
  href: string;
  count?: number;
  active?: boolean;
}

interface Props {
  tabs: Tab[];
  label: string;
}

const { tabs, label } = Astro.props;
---

<nav class="tabs" aria-label={label}>
  {
    tabs.map((tab) => (
      <a href={tab.href} class:list={['tab', { active: tab.active }]} aria-current={tab.active ? 'page' : undefined}>
        <span>{tab.label}</span>
        {tab.count !== undefined && <span class="count tnum">{tab.count}</span>}
      </a>
    ))
  }
</nav>

<style>
  .tabs {
    display: flex;
    gap: var(--space-5);
    border-bottom: 1px solid var(--border);
  }

  .tab {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    color: var(--muted);
    font-weight: var(--weight-medium);
    text-decoration: none;
  }

  .tab:hover {
    color: var(--ink);
  }

  .tab.active {
    color: var(--ink);
  }

  .tab.active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 3px;
    border-radius: 3px 3px 0 0;
    background: var(--accent);
  }

  .count {
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    display: inline-grid;
    place-items: center;
    border-radius: var(--radius-pill);
    background: var(--surface);
    font-size: var(--text-caption);
    color: var(--muted);
  }

  .tab.active .count {
    background: var(--brand-soft);
    color: var(--brand);
  }
</style>
