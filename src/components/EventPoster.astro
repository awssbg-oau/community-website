---
import Icon from './Icon.astro';
import type { EventEntry } from '../lib/events';

interface Props {
  event: EventEntry;
  tone: 'cream' | 'orange' | 'ink';
  index?: number;
}

const { event, tone, index = 0 } = Astro.props;
const { title, kind, start, attended, highlight, mode, venue } = event.data;
const day = new Intl.DateTimeFormat('en-GB', { day: '2-digit', timeZone: 'Africa/Lagos' }).format(start);
const month = new Intl.DateTimeFormat('en-GB', { month: 'short', timeZone: 'Africa/Lagos' }).format(start).toUpperCase();
const kindLabel = { kickoff: 'Kickoff', workshop: 'Workshop', talk: 'Talk', lab: 'Lab', hangout: 'Hangout' }[kind];
---

<article class:list={['poster', `tone-${tone}`]} data-reveal style={`--i:${index}`}>
  <div class="top">
    <span class="kind">{kindLabel}</span>
    <span class="mode"><Icon name={mode === 'online' ? 'online' : 'location'} size={14} />{venue}</span>
  </div>
  <p class="date tnum"><span>{day}</span><span>{month}</span></p>
  <h3 class="title"><a href={`/events/${event.id}/`}>{title}</a></h3>
  {highlight && <p class="hl">{highlight}</p>}
  {
    attended !== undefined && (
      <p class="count tnum">
        <span class="n">{attended}</span>
        <span>attended</span>
      </p>
    )
  }
</article>

<style>
  .poster {
    display: grid;
    grid-template-rows: auto auto 1fr auto auto;
    gap: var(--space-3);
    min-height: 360px;
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    transition: transform var(--dur-base) var(--ease-spring);
  }

  .poster:hover {
    transform: translateY(-4px) rotate(-0.6deg);
  }

  .tone-cream {
    background: #fff2dc;
    color: #0f141a;
    --soft: #5c4a2c;
  }

  .tone-orange {
    background: #ff9900;
    color: #0f141a;
    --soft: #3b2a10;
  }

  .tone-ink {
    background: #141b25;
    color: #ffffff;
    --soft: #b9c2cf;
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2);
    font-size: var(--text-small);
  }

  .kind {
    padding: 3px 10px;
    border: 1.5px solid currentColor;
    border-radius: var(--radius-pill);
    font-weight: var(--weight-medium);
  }

  .mode {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--soft);
  }

  .date {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin-top: var(--space-3);
    font-family: var(--font-display);
    line-height: 0.9;
  }

  .date span:first-child {
    font-size: 5rem;
  }

  .date span:last-child {
    font-size: 1.5rem;
  }

  .title {
    font-size: 1.375rem;
    line-height: 1.2;
    align-self: start;
  }

  .title a {
    color: inherit;
    text-decoration: none;
  }

  .title a:hover {
    text-decoration: underline;
  }

  .hl {
    color: var(--soft);
    font-size: var(--text-small);
  }

  .count {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1.5px solid currentColor;
    font-size: var(--text-small);
  }

  .n {
    font-family: var(--font-display);
    font-size: 2.25rem;
    line-height: 1;
  }
</style>
