---
import Icon from './Icon.astro';
import Wordmark from './Wordmark.astro';
import site from '../data/site.json';
import type { IconName } from '../lib/icons';

const links: { label: string; href: string; icon: IconName }[] = [
  { label: 'WhatsApp', href: site.links.whatsapp, icon: 'whatsapp' },
  { label: 'Meetup', href: site.links.meetup, icon: 'calendar' },
  { label: 'LinkedIn', href: site.links.linkedin, icon: 'linkedin' },
  { label: 'X', href: site.links.x, icon: 'x' },
  { label: 'Email', href: site.links.email ? `mailto:${site.links.email}` : '', icon: 'mail' },
].filter((link) => link.href);
---

<footer class="footer">
  <div class="page inner">
    <div class="id">
      <Wordmark size="large" />
    </div>
    <ul class="links">
      {
        links.map((link) => (
          <li>
            <a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={link.label} title={link.label}>
              <Icon name={link.icon} size={22} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-9);
    border-top: 1px solid var(--border);
  }

  .inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-5);
    padding-block: var(--space-7);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links a {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    color: var(--ink);
    text-decoration: none;
    transition:
      color 160ms ease,
      border-color 160ms ease;
  }

  .links a:hover {
    color: var(--brand);
    border-color: var(--brand);
  }

  @media (max-width: 640px) {
    .inner {
      grid-template-columns: 1fr;
    }
  }
</style>
