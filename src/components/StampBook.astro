---
import Button from './Button.astro';
import SbgMark from './SbgMark.astro';
import Stamp from './Stamp.astro';
import site from '../data/site.json';

const visas = [
  { id: 'workshop', title: 'Workshops', text: 'Live sessions that start from the basics.', word: 'Workshop', ring: 'AWS SBG · OAU · From zero', icon: 'learn', tone: 'orange', shape: 'round', r: -8, x: 3, y: 4 },
  { id: 'lab', title: 'Hands-On Labs', text: 'Ship something real on AWS, with people around to help.', word: 'Deployed', ring: 'Hands-On Lab', icon: 'build', tone: 'ink', shape: 'rect', r: 7, x: 52, y: 8 },
  { id: 'hangout', title: 'Hangouts', text: 'Calls and meetups with the people building next to you.', word: 'Hangout', ring: 'OAU · Meet builders', icon: 'people', tone: 'blue', shape: 'round', r: -4, x: 3, y: 52 },
  { id: 'cert', title: 'Credits And Certs', text: 'AWS credits, Builder Center and a path to certification.', word: 'Certified', ring: 'AWS Credits', icon: 'grow', tone: 'orange', shape: 'rect', r: 8, x: 54, y: 58 },
] as const;
---

<div class="pin" data-book>
  <div class="stick">
    <div class="book closed" data-book-el>
      <div class="cover" aria-hidden="true">
        <div class="cv-face cv-front sbg-grid">
          <p class="cv-top">Passport</p>
          <span class="cv-mark"><SbgMark size={96} /></span>
          <div class="cv-names">
            <p>AWS Student Builder Group</p>
            <p class="cv-school">Obafemi Awolowo University</p>
          </div>
          <svg class="cv-chip" viewBox="0 0 48 30"><rect x="1" y="1" width="46" height="28" rx="3" /><circle cx="24" cy="15" r="7" /><line x1="1" y1="15" x2="17" y2="15" /><line x1="31" y1="15" x2="47" y2="15" /></svg>
        </div>
        <div class="cv-face cv-back sbg-grid-light"></div>
      </div>
      <div class="page left sbg-grid-light">
        <p class="pg-label">Visas</p>
        <ol class="visas">
          {
            visas.map((v, i) => (
              <li class="visa" data-visa={i}>
                <span class="num tnum">0{i + 1}</span>
                <div class="v-copy">
                  <h4>{v.title}</h4>
                  <p>{v.text}</p>
                </div>
                <span class="tick">Stamped</span>
              </li>
            ))
          }
        </ol>
        <div class="tally">
          <div class="cta" data-book-cta>
            <Button href={site.links.membershipForm} trailing="external" external size="sm">Get The Real One</Button>
          </div>
        </div>
      </div>
      <div class="page right sbg-grid-light">
        <p class="pg-label">Entries</p>
        <div class="area" data-book-area>
          {
            visas.map((v, i) => (
              <div class="spot" data-spot={i} style={`left:${v.x}%;top:${v.y}%`}>
                <Stamp id={`book-${v.id}`} word={v.word} ring={v.ring} icon={v.icon} tone={v.tone} shape={v.shape} rotate={v.r} index={0} />
              </div>
            ))
          }
          <div class="stamper" data-stamper aria-hidden="true">
            <svg viewBox="0 0 120 150">
              <rect x="42" y="6" width="36" height="36" rx="18" class="knob" />
              <rect x="52" y="38" width="16" height="42" rx="6" class="neck" />
              <rect x="14" y="76" width="92" height="40" rx="8" class="block" />
              <rect x="10" y="114" width="100" height="16" rx="4" class="rubber" />
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-book]').forEach((root) => {
    const stick = root.querySelector<HTMLElement>('.stick');
    const area = root.querySelector<HTMLElement>('[data-book-area]');
    const stamper = root.querySelector<HTMLElement>('[data-stamper]');
    const spots = Array.from(root.querySelectorAll<HTMLElement>('[data-spot]'));
    const book = root.querySelector<HTMLElement>('[data-book-el]');
    const visas = Array.from(root.querySelectorAll<HTMLElement>('[data-visa]'));
    if (!stick || !area || !stamper || !book) return;
    let open = false;
    const TURN = 900;
    const rightPage = root.querySelector<HTMLElement>('.right');
    const sizeCover = () => {
      if (rightPage) book.style.setProperty('--right-h', `${rightPage.offsetHeight}px`);
    };
    sizeCover();
    window.addEventListener('resize', sizeCover);
    let done = 0;
    let queue = Promise.resolve();

    const aim = (i: number) => {
      const s = spots[i].getBoundingClientRect();
      const a = area.getBoundingClientRect();
      const w = stamper.offsetWidth;
      const x = s.left - a.left + s.width / 2 - w / 2;
      const y = s.top - a.top + s.height / 2 - w * 1.15;
      stamper.style.setProperty('--sx', `${x}px`);
      stamper.style.setProperty('--sy', `${y}px`);
    };
    const wait = (ms: number) => new Promise((r) => window.setTimeout(r, ms));
    const setDone = (n: number) => {
      done = n;
      visas.forEach((v, i) => {
        v.classList.toggle('done', i < n);
        v.classList.toggle('latest', i === n - 1 && n < spots.length);
      });
      root.classList.toggle('complete', n === spots.length);
    };
    const stampOne = async (i: number) => {
      if (reduce) {
        spots[i].querySelector('[data-stamp]')?.classList.add('down');
        setDone(i + 1);
        return;
      }
      aim(i);
      stamper.classList.add('show');
      await wait(260);
      stamper.classList.add('press');
      await wait(140);
      spots[i].querySelector('[data-stamp]')?.classList.add('down', 'instant');
      setDone(i + 1);
      await wait(180);
      stamper.classList.remove('press');
      if (i === spots.length - 1) {
        await wait(260);
        stamper.classList.remove('show');
      }
    };
    const unstamp = (i: number) => {
      spots[i].querySelector('[data-stamp]')?.classList.remove('down', 'instant');
      setDone(i);
      if (i === 0) stamper.classList.remove('show');
    };

    const HOLD = 260;
    const pinned = () => parseFloat(getComputedStyle(stick).top) || 0;
    const travelled = () => pinned() - root.getBoundingClientRect().top;
    const target = () => {
      const distance = root.offsetHeight - stick.offsetHeight - HOLD;
      const p = distance > 0 ? Math.min(1, Math.max(0, (travelled() - HOLD) / distance)) : 0;
      return Math.min(spots.length, Math.floor(p * (spots.length + 0.6)));
    };
    const shouldOpen = () => travelled() >= (open ? HOLD * 0.6 : HOLD);
    const sync = () => {
      queue = queue.then(async () => {
        if (shouldOpen() && !open) {
          open = true;
          book.classList.remove('closed');
          if (!reduce) {
            book.classList.add('opening');
            await wait(TURN);
            book.classList.remove('opening');
          }
        }
        const want = open ? target() : 0;
        while (done < want) await stampOne(done);
        while (done > want) unstamp(done - 1);
        if (!shouldOpen() && open && done === 0) {
          open = false;
          stamper.classList.remove('show');
          book.classList.add('closed');
          if (!reduce) {
            book.classList.add('closing');
            await wait(TURN);
            book.classList.remove('closing');
          }
        }
      });
    };
    setDone(0);
    window.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync);
    sync();
  });
</script>

<style>
  .pin {
    position: relative;
    height: calc(100svh + 1160px);
  }

  .stick {
    position: sticky;
    top: 88px;
    padding: var(--space-4) 0;
  }

  .book {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    max-width: 1060px;
    margin-inline: auto;
    color: #0f141a;
    perspective: 2400px;
    transition: transform 900ms cubic-bezier(0.45, 0.05, 0.2, 1);
  }

  .book.closed {
    transform: translateX(-25%);
  }

  .left {
    border: 2px solid #0f141a;
    border-right-width: 1.5px;
    border-radius: 18px 0 0 18px;
    transition: opacity 120ms linear 640ms;
  }

  .right {
    border: 2px solid #0f141a;
    border-left-width: 1.5px;
    border-radius: 0 18px 18px 0;
  }

  .book.closed .left {
    opacity: 0;
    transition-delay: 0ms;
  }

  .book.closed:not(.closing) .right {
    visibility: hidden;
  }

  .cover {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    right: 0;
    z-index: 8;
    transform-origin: left center;
    transform-style: preserve-3d;
    transform: rotateY(-180deg);
    visibility: hidden;
    pointer-events: none;
  }

  .book.closed .cover,
  .book.opening .cover,
  .book.closing .cover {
    visibility: visible;
  }

  .book.closed .cover {
    transform: rotateY(0deg);
  }

  .book.opening .cover {
    animation: turn-open 900ms cubic-bezier(0.45, 0.05, 0.2, 1) both;
  }

  .book.closing .cover {
    animation: turn-close 900ms cubic-bezier(0.45, 0.05, 0.2, 1) both;
  }

  .cv-face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    border: 2px solid #0f141a;
    overflow: hidden;
  }

  .cv-face::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #0f141a;
    opacity: 0;
    pointer-events: none;
  }

  .cv-front {
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    justify-items: center;
    gap: var(--space-4);
    padding: var(--space-7) var(--space-5) var(--space-6);
    border-radius: 4px 18px 18px 4px;
    background-color: #232f3e;
    color: #ffffff;
    text-align: center;
  }

  .cv-back {
    transform: rotateY(180deg);
    border-radius: 18px 4px 4px 18px;
    background-color: #fffaf1;
  }

  .book.opening .cv-front::after {
    animation: shade-out 900ms cubic-bezier(0.45, 0.05, 0.2, 1) both;
  }

  .book.opening .cv-back::after {
    animation: shade-in 900ms cubic-bezier(0.45, 0.05, 0.2, 1) both;
  }

  .book.closing .cv-front::after {
    animation: shade-in 900ms cubic-bezier(0.45, 0.05, 0.2, 1) reverse both;
  }

  .book.closing .cv-back::after {
    animation: shade-out 900ms cubic-bezier(0.45, 0.05, 0.2, 1) reverse both;
  }

  @keyframes flip-open {
    0% {
      transform: rotateX(0deg) translateZ(0);
    }

    50% {
      transform: rotateX(90deg) translateZ(30px);
    }

    100% {
      transform: rotateX(180deg) translateZ(0);
    }
  }

  @keyframes flip-close {
    0% {
      transform: rotateX(180deg) translateZ(0);
    }

    50% {
      transform: rotateX(90deg) translateZ(30px);
    }

    100% {
      transform: rotateX(0deg) translateZ(0);
    }
  }

  @keyframes turn-open {
    0% {
      transform: rotateY(0deg) translateZ(0);
    }

    50% {
      transform: rotateY(-90deg) translateZ(36px);
    }

    100% {
      transform: rotateY(-180deg) translateZ(0);
    }
  }

  @keyframes turn-close {
    0% {
      transform: rotateY(-180deg) translateZ(0);
    }

    50% {
      transform: rotateY(-90deg) translateZ(36px);
    }

    100% {
      transform: rotateY(0deg) translateZ(0);
    }
  }

  @keyframes shade-out {
    0% {
      opacity: 0;
    }

    50% {
      opacity: 0.45;
    }

    100% {
      opacity: 0.45;
    }
  }

  @keyframes shade-in {
    0% {
      opacity: 0.45;
    }

    50% {
      opacity: 0.45;
    }

    100% {
      opacity: 0;
    }
  }

  .cv-top {
    font-family: var(--font-mono);
    font-size: 1rem;
    text-transform: uppercase;
    color: #ff9900;
  }

  .cv-mark {
    align-self: center;
    color: #ff9900;
  }

  .cv-names {
    display: grid;
    gap: 4px;
    font-family: var(--font-display);
    font-size: 1.25rem;
  }

  .cv-school {
    color: #d5dbe3;
    font-size: 0.9375rem;
  }

  .cv-chip {
    width: 48px;
    fill: none;
    stroke: #ff9900;
    stroke-width: 1.6;
  }

  @media (prefers-reduced-motion: reduce) {
    .book,
    .left {
      transition: none;
    }
  }

  .page {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-4);
    min-height: min(560px, calc(100svh - 150px));
    padding: var(--space-6);
    background-color: #fffaf1;
    overflow: hidden;
  }

  .left {
    grid-template-rows: auto 1fr auto;
  }

  .pg-label {
    color: #5f6775;
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    text-transform: uppercase;
  }

  .visas {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .visa {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) auto;
    gap: var(--space-3);
    align-items: center;
    padding: var(--space-3) var(--space-4);
    border: 1.5px solid #ff9900;
    border-radius: 12px;
    background: #fff2dc;
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 320ms var(--ease-out),
      transform 420ms var(--ease-spring);
  }

  .num {
    font-family: var(--font-mono);
    color: #5f6775;
  }

  .v-copy h4 {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: var(--weight-medium);
  }

  .v-copy p {
    color: #3f4652;
    font-size: var(--text-small);
  }

  .tick {
    padding: 3px 9px;
    border-radius: 999px;
    background: #0f141a;
    color: #ff9900;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    opacity: 0;
    transform: scale(0.8);
    transition:
      opacity var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-spring);
  }

  .visa.done {
    opacity: 1;
    transform: none;
  }

  .visa.latest {
    border-color: #0f141a;
    background: #ffffff;
  }

  .visa.done .tick {
    opacity: 1;
    transform: none;
    transition-delay: 180ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .visa {
      transform: none;
    }
  }

  .tally {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .cta {
    opacity: 0;
    transform: translateY(6px);
    pointer-events: none;
    transition:
      opacity var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-spring);
  }

  .complete .cta {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .area {
    position: relative;
    height: 100%;
    min-height: 440px;
  }

  .spot {
    position: absolute;
  }

  .spot :global(.stamp) {
    width: 190px;
  }

  .spot :global(.shape-rect) {
    width: 220px;
  }

  .spot :global(.stamp.instant) {
    animation-duration: 260ms !important;
    animation-delay: 0ms !important;
  }

  .stamper {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 5;
    width: 120px;
    opacity: 0;
    transform: translate(var(--sx, 200px), calc(var(--sy, 0px) - 170px));
    transition:
      transform 260ms var(--ease-out),
      opacity 200ms var(--ease-out);
    pointer-events: none;
  }

  .stamper.show {
    opacity: 1;
    transform: translate(var(--sx), calc(var(--sy) - 130px));
  }

  .stamper.press {
    transform: translate(var(--sx), calc(var(--sy) + 18px)) scaleY(0.96);
    transition-duration: 120ms;
  }

  .knob,
  .neck {
    fill: #0f141a;
  }

  .block {
    fill: #ff9900;
    stroke: #0f141a;
    stroke-width: 3;
  }

  .rubber {
    fill: #0f141a;
  }

  @media (max-width: 860px) {
    .book {
      grid-template-columns: 1fr;
      perspective: 1600px;
    }

    .book.closed {
      transform: none;
    }

    .left {
      border: 2px solid #0f141a;
      border-top-width: 1.5px;
      border-radius: 0 0 18px 18px;
    }

    .right {
      border: 2px solid #0f141a;
      border-bottom-width: 1.5px;
      border-radius: 18px 18px 0 0;
    }

    .book.closed:not(.closing) .right {
      visibility: visible;
    }

    .cover {
      left: 0;
      bottom: auto;
      height: var(--right-h, 58%);
      transform-origin: center top;
      transform: rotateX(180deg);
    }

    .book.closed .cover {
      transform: rotateX(0deg);
    }

    .book.opening .cover {
      animation-name: flip-open;
    }

    .book.closing .cover {
      animation-name: flip-close;
    }

    .cv-front,
    .cv-back {
      border-radius: 18px;
    }

    .cv-back {
      transform: rotateX(180deg);
    }

    .cv-front {
      padding: var(--space-5);
    }

    .right {
      order: -1;
      min-height: 0;
      padding: var(--space-4);
    }

    .left {
      min-height: 0;
      padding: var(--space-4);
    }

    .area {
      min-height: 300px;
    }

    .spot :global(.stamp) {
      width: 128px;
    }

    .spot :global(.shape-rect) {
      width: 150px;
    }

    .stamper {
      width: 84px;
    }

    .visa {
      padding: var(--space-2) var(--space-3);
    }

    .visa:not(.latest) .v-copy p {
      display: none;
    }

    .area {
      min-height: 310px;
    }

    .left {
      gap: var(--space-3);
    }

    .stick {
      top: 72px;
    }
  }
</style>
