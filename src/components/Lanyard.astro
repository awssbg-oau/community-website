---
import Chip from './Chip.astro';
import SbgMark from './SbgMark.astro';

interface Props {
  rope?: number;
}

const { rope = 190 } = Astro.props;
---

<div class="lanyard" data-lanyard data-rope={rope} style={`--rope:${rope}px`} aria-hidden="true">
  <svg class="strap-svg">
    <path data-strap class="strap" />
  </svg>
  <div class="badge" data-badge>
    <span class="clip"><span class="clip-slot"></span></span>
    <div class="card">
      <span class="hole"></span>
      <div class="pp-head">
        <SbgMark size={16} />
        <span>AWS SBG · Passport</span>
      </div>
      <div class="pp-body">
        <div class="photo sbg-grid-light" data-passport-photo>
          <div class="photo-chip"><Chip pose="idle" size={78} /></div>
          <span class="away-note">Out Guiding</span>
        </div>
        <dl class="fields">
          <div><dt>Name</dt><dd>Chip</dd></div>
          <div><dt>Role</dt><dd>Guide</dd></div>
          <div><dt>Issued</dt><dd>OAU, Ile-Ife</dd></div>
          <div><dt>No.</dt><dd>SBG-0001</dd></div>
        </dl>
      </div>
      <p class="mrz">P&lt;SBG&lt;OAU&lt;&lt;CHIP&lt;&lt;BUILDER&lt;&lt;&lt;<br />SBG0001&lt;&lt;ILEIFE&lt;&lt;2026&lt;&lt;&lt;&lt;&lt;</p>
      <div class="foot">AWS Student Builder Group</div>
    </div>
  </div>
</div>

<script>
  import '../scripts/lanyard.ts';
</script>

<style>
  .lanyard {
    position: relative;
    width: 100%;
    height: calc(var(--rope) + 400px);
    pointer-events: none;
  }

  .strap-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .strap {
    fill: none;
    stroke: var(--accent);
    stroke-width: 16;
    stroke-linejoin: round;
  }

  .lanyard:not(.ready)::before {
    content: '';
    position: absolute;
    top: 0;
    left: calc(50% - 8px);
    width: 16px;
    height: var(--rope);
    background: var(--accent);
  }

  .badge {
    position: absolute;
    top: 0;
    left: 0;
    width: 248px;
    transform-origin: 50% 0;
    cursor: grab;
    pointer-events: auto;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }

  .lanyard:not(.ready) .badge {
    left: 50%;
    transform: translate(-50%, var(--rope));
  }

  .dragging .badge {
    cursor: grabbing;
  }

  .clip {
    position: absolute;
    top: -14px;
    left: 50%;
    width: 40px;
    height: 30px;
    margin-left: -20px;
    border-radius: 6px;
    background: #8c8c94;
    z-index: 1;
  }

  .clip-slot {
    position: absolute;
    left: 10px;
    right: 10px;
    top: 7px;
    height: 6px;
    border-radius: 3px;
    background: #424650;
  }

  .card {
    position: relative;
    display: grid;
    gap: 10px;
    padding: 28px 14px 0;
    border: 2px solid #0f141a;
    border-radius: 16px;
    background: #ffffff;
    color: #0f141a;
    overflow: hidden;
  }

  .hole {
    position: absolute;
    top: 10px;
    left: 50%;
    width: 44px;
    height: 8px;
    margin-left: -22px;
    border-radius: 4px;
    background: #c6c6cd;
  }

  .pp-head {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    border-radius: 8px;
    background: #0f141a;
    color: #ff9900;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
  }

  .pp-head span {
    color: #ffffff;
  }

  .pp-body {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 12px;
  }

  .photo {
    position: relative;
    display: grid;
    place-items: end center;
    height: 112px;
    border: 1.5px solid #0f141a;
    border-radius: 8px;
    background-color: #fff2dc;
    overflow: hidden;
  }

  .photo-chip {
    margin-bottom: -18px;
    transition:
      opacity var(--dur-base) var(--ease-out),
      transform var(--dur-slow) var(--ease-spring);
  }

  .away-note {
    position: absolute;
    inset: 10px;
    display: grid;
    place-items: center;
    border: 1.5px dashed #b7bfcc;
    border-radius: 6px;
    color: #5f6775;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    text-align: center;
    text-transform: uppercase;
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out);
  }

  :global(.guide-out) .photo-chip {
    opacity: 0;
    transform: translateY(20px) scale(0.6);
  }

  :global(.guide-out) .away-note {
    opacity: 1;
  }

  .fields {
    display: grid;
    gap: 5px;
    margin: 0;
    align-content: start;
  }

  .fields dt {
    color: #5f6775;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    text-transform: uppercase;
  }

  .fields dd {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: var(--weight-medium);
    line-height: 1.2;
  }

  .mrz {
    margin: 2px 0 0;
    color: #3f4652;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    line-height: 1.5;
    white-space: nowrap;
    overflow: hidden;
  }

  .foot {
    margin: 0 -14px;
    padding: 9px 0;
    background: #ff9900;
    color: #0f141a;
    font-size: 0.6875rem;
    font-weight: var(--weight-medium);
    text-align: center;
    text-transform: uppercase;
  }

  @media (max-width: 560px) {
    .lanyard {
      height: calc(var(--rope) * 0.8 + 320px);
    }

    .badge {
      width: 220px;
    }

    .pp-body {
      grid-template-columns: 84px 1fr;
    }

    .photo {
      height: 100px;
    }
  }
</style>
